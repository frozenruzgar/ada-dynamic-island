    "Aşağıdaki metni Türkçe, kısa ve anlaşılır biçimde özetle. Ana noktaları koru:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni Türkçe, kısa ve anlaşılır biçimde özetle. Ana noktaları koru:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize the following text briefly and clearly in English. Keep the main points:"
          }
        }
      }
    },
    "Aşağıdaki metni doğal ve anlamı koruyan bir İngilizceyle çevir:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni doğal ve anlamı koruyan bir İngilizceyle çevir:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the following text into natural English while preserving its meaning:"
          }
        }
      }
    },
    "Aşağıdaki metnin anlamını koruyarak yazımını ve anlatımını düzelt. Yalnızca düzeltilmiş metni ver:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metnin anlamını koruyarak yazımını ve anlatımını düzelt. Yalnızca düzeltilmiş metni ver:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve the spelling and wording of the following text while preserving its meaning. Return only the revised text:"
          }
        }
      }
    },
    "Aşağıdaki notlardan konu satırı ve gövdesi olan açık, profesyonel bir Türkçe e-posta taslağı hazırla. Eksik bilgileri uydurma:": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki notlardan konu satırı ve gövdesi olan açık, profesyonel bir Türkçe e-posta taslağı hazırla. Eksik bilgileri uydurma:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft a clear, professional email in English with a subject and body from these notes. Do not invent missing information:"
          }
        }
      }
    },
